# Auto detect text files and normalize line endings to CRLF on checkout
* text=auto eol=crlf

# Explicitly declare text files you want to always be normalized and converted to CRLF
*.rs text eol=crlf
*.toml text eol=crlf
*.md text eol=crlf
*.json text eol=crlf

# Denote all files that are truly binary and should not be modified
# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.svg binary

# Executables and libraries
*.exe binary
*.dll binary
*.so binary
*.a binary
*.lib binary
*.dylib binary
*.o binary

# Firmware and embedded binaries
*.elf binary
*.eav binary
*.bin binary
*.uf2 binary
*.hex binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Preserve exact upstream crate bytes for the recorded provenance hashes.
firmware/vendor/** -text
# Preserve the published pin table's one trailing space and archive hash.
firmware/vendor/embassy-rp/funcsel.txt -whitespace

# Preserve exact bytes of the new measured captures and their digest sidecars.
host/baselines/audit2_*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
host/baselines/configurator_*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve the frozen v3 JSON fixture's exact original bytes.
crates/dashboard-config/tests/fixtures/v3-default.json -text
